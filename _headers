# Keep the pages.dev test site out of search results; skripta.ba stays indexable.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

/css/*
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
